{
  "manifest_version": 3,
  "name": "Scan & Solve",
  "description": "Drag over a question and see an answer with step-by-step help.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scan a question"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Scan a question"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
