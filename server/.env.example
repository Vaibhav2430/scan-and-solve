# Default hosted mode. Use a key from a Gemini API project whose Billing Tier is Free.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional OpenAI fallback. It is used only when AI_PROVIDER=openai.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
